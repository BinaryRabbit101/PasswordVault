# Dusk browser-test environment. Copy to .env.dusk.local (git-ignored), set
# APP_KEY (php artisan key:generate --show), then follow CLAUDE.md →
# Browser tests. Never point this at a real vault database.
APP_NAME=PasswordVault
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8449

DB_CONNECTION=sqlite
DB_DATABASE=database/testing/dusk.sqlite

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BROADCAST_CONNECTION=log

VAULT_CLIPBOARD_CLEAR_SECONDS=30
VAULT_API_RETURNS_PASSWORDS=true
